{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public profile for developers in the networking module.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "stack": { "type": "array", "items": { "type": "string" } },
        "interests": { "type": "array", "items": { "type": "string" } },
        "github": { "type": "string" },
        "website": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "updatedAt"]
    },
    "ProjectFile": {
      "title": "Project File",
      "description": "Code files saved by users in their dashboard.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "language": { "type": "string" },
        "content": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "language", "content", "userId", "updatedAt"]
    },
    "Analysis": {
      "title": "Analysis Result",
      "description": "Sagas and module explanations generated by AI.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["saga", "explanation"] },
        "sourceCode": { "type": "string" },
        "result": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "sourceCode", "result", "userId", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Developer profile documents."
    },
    "users/{userId}/files/{fileId}": {
      "schema": "ProjectFile",
      "description": "Code files belonging to a specific user."
    },
    "users/{userId}/analyses/{analysisId}": {
      "schema": "Analysis",
      "description": "AI analysis results for a specific user."
    }
  }
}
